# Backend base URL for API calls (ExpressBackend)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Optional: Monitoring and Notification services (proxy via backend typically)
NEXT_PUBLIC_MONITORING_BASE_URL=http://localhost:3001
NEXT_PUBLIC_NOTIFICATION_BASE_URL=http://localhost:3001

# Site URL for redirects (used by auth flows if needed)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Feature flags
NEXT_PUBLIC_FEATURE_REALTIME_PREVIEW=true
NEXT_PUBLIC_FEATURE_EXPERIMENTAL_THEMES=true
